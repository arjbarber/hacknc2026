# Copy to deploy/.env on the server. These are deployment settings, not secrets
# (the API keys live in the repo-root .env).

# The backend address browsers will call. Use the server's public (static) IP or a
# domain, plus BACKEND_PORT. The frontend is built with this baked in, so rebuild
# the frontend (docker compose ... up -d --build frontend) after changing it.
PUBLIC_API_URL=http://YOUR.SERVER.IP:8080

# Host ports. Pick ones not already in use (this server already uses 5000 and 8000).
BACKEND_PORT=8080
FRONTEND_PORT=3000
