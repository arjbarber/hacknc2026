# Copy to deploy/.env on the server. These are deployment settings, not secrets
# (the API keys live in the repo-root .env).

# Host port for the backend. Pick one not already in use (check: sudo ss -tlnp).
# Behind nginx (the current setup), bind to localhost so only nginx can reach it:
BACKEND_PORT=127.0.0.1:8080

# Only needed with --profile frontend: the backend address browsers will call, baked into
# the frontend build. Rebuild the frontend after changing it.
# PUBLIC_API_URL=http://YOUR.SERVER.IP:8080
# FRONTEND_PORT=3000
